# ── KRAKEN Infrastructure Environment Variables ───────────────────────────────
# Copy this file to infra/.env and fill in all values before running infra-up.
# NEVER commit infra/.env — it is gitignored.
# Use Supabase credential store or Infisical for production secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────

# Master Postgres password (used by all Supabase internal services)
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password

# JWT signing secret — must be >= 32 characters, random, kept private
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-secret-at-least-32-chars

# Anon (public) JWT — safe to expose to browser clients
# Generate at: https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-payload.signature

# Service role JWT — server-side only, bypasses Row Level Security
# Generate alongside ANON_KEY using the same JWT_SECRET
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-payload.signature

# Supabase Studio login credentials
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=your-dashboard-password

# ── Langfuse ──────────────────────────────────────────────────────────────────

# NextAuth signing secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret

# Password hashing salt — generate with: openssl rand -base64 32
SALT=your-langfuse-salt

# Langfuse SDK keys — created via the Langfuse UI after first startup
# These are written here for reference; agents read them from the credential store
LANGFUSE_SECRET_KEY=lf-sk-your-langfuse-secret-key
LANGFUSE_PUBLIC_KEY=lf-pk-your-langfuse-public-key
LANGFUSE_HOST=http://localhost:3000

# ── PostHog ───────────────────────────────────────────────────────────────────

# PostHog Django SECRET_KEY — generate with: openssl rand -base64 32
POSTHOG_SECRET_KEY=your-posthog-secret-key

# PostHog project API key — created via PostHog UI after first startup
# Used by the KRAKEN UI to send product analytics events
POSTHOG_PROJECT_API_KEY=phc_your-posthog-project-api-key

# ── Trigger.dev ───────────────────────────────────────────────────────────────

# Trigger.dev session secret — generate with: openssl rand -hex 32
TRIGGER_SESSION_SECRET=your-trigger-session-secret

# Trigger.dev magic link secret — generate with: openssl rand -hex 32
TRIGGER_MAGIC_LINK_SECRET=your-trigger-magic-link-secret

# Trigger.dev encryption key — must be exactly 32 hex bytes (64 hex chars)
# Generate with: openssl rand -hex 32
TRIGGER_ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here-64-chars

# Trigger.dev project API key — created via Trigger.dev UI after first startup
TRIGGER_API_KEY=tr_dev_your-trigger-api-key

# ── Anthropic ─────────────────────────────────────────────────────────────────

# Anthropic API key for Claude Opus 4.6
# See: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# ── Coral ─────────────────────────────────────────────────────────────────────

# Path to the Coral binary on the host machine
# Install from: https://withcoral.com/docs/install
CORAL_BINARY_PATH=/usr/local/bin/coral

# Path to the Coral configuration file (see infra/coral.yaml.example)
CORAL_CONFIG_PATH=~/.kraken/coral.yaml

# Coral MCP server port (used by KRAKEN Python agents)
CORAL_MCP_PORT=6006

# ── LiteLLM (model gateway) ───────────────────────────────────────────────────

LITELLM_MASTER_KEY=sk-your-litellm-master-key
LITELLM_PORT=4000

# ── KRAKEN runtime ────────────────────────────────────────────────────────────

# Set to 1 to serve fixture data without a live Coral connection (demos/CI)
KRAKEN_DEMO_MODE=0

# Bearer token guarding the KRAKEN API. When set, every /api/* data endpoint
# requires `Authorization: Bearer <token>`. REQUIRED in non-demo deployments —
# the server refuses to start without it unless KRAKEN_DEMO_MODE=1.
# Generate with: openssl rand -hex 32
KRAKEN_API_TOKEN=

# Comma-separated browser origins allowed to call the API (CORS).
KRAKEN_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Supabase app-level credentials (used by the Python backend for auth + realtime)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-payload.signature
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-payload.signature

# ── Webhook HMAC secrets (one per source) ─────────────────────────────────────
# Set each to the webhook secret configured in the provider's dashboard.
# Alternatively, set KRAKEN_WEBHOOK_SECRET as a single shared secret for testing.
KRAKEN_WEBHOOK_SECRET_GITHUB=your-github-webhook-secret
KRAKEN_WEBHOOK_SECRET_SENTRY=your-sentry-webhook-secret
KRAKEN_WEBHOOK_SECRET_STRIPE=your-stripe-webhook-secret
KRAKEN_WEBHOOK_SECRET_PAGERDUTY=your-pagerduty-webhook-secret
KRAKEN_WEBHOOK_SECRET_LINEAR=your-linear-webhook-secret

# ── Gmail OAuth (exec-escalation V6 voyage) ───────────────────────────────────
# Google OAuth2 access token for reading the user's Gmail inbox.
# Obtain via Google OAuth2 flow; stored in Supabase credential store in production.
GMAIL_OAUTH_TOKEN=ya29.your-google-oauth2-access-token
